---
// LinkCard.astro
// A large clickable card: image on top, then a title and a short description.
// The whole card is one link.
//
// Right now:  <LinkCard href="/art/series" title="Series" placeholder="[Series image]" />
//             → a dashed placeholder box where the image will go
// Later:      import seriesImg from '../assets/images/series-cover.jpg';
//             <LinkCard href="/art/series" title="Series" image={seriesImg} imageAlt="..." />
//             → the real image, optimized by <Image />, in the same 4:3 box
//
// variant="door": no card box at all. Just the image at its natural shape with the
// title below, and the image swings open like a door on hover.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	href: string;
	title: string;
	description?: string;
	image?: ImageMetadata; // an image imported from src/assets/images/
	imageAlt?: string;
	placeholder?: string; // label shown in the dashed box until there's a real image
	variant?: 'card' | 'door';
}

const {
	href,
	title,
	description,
	image,
	imageAlt = '',
	placeholder = '[Image goes here]',
	variant = 'card',
} = Astro.props;
---

<a class:list={['link-card', { 'link-card--door': variant === 'door' }]} href={href}>
	{
		image ? (
			<Image src={image} alt={imageAlt} width={variant === 'door' ? 1200 : 800} class="card-image" />
		) : (
			<div class="card-image card-image-placeholder">{placeholder}</div>
		)
	}
	<div class="card-body">
		<h2 class="card-title">{title}</h2>
		{description && <p class="card-description">{description}</p>}
	</div>
</a>

<style>
	.link-card {
		display: flex;
		flex-direction: column;
		height: 100%; /* cards in the same row match heights */
		color: inherit;
		text-decoration: none;
		background: #fff;
		border: 1px solid #e5e0d5;
		border-radius: 12px;
		overflow: hidden; /* clips the image to the rounded corners */
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	/* Same 4:3 box for the placeholder and the real image, so swapping doesn't shift anything. */
	.card-image {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}
	.card-image-placeholder {
		display: grid;
		place-items: center;
		border-bottom: 2px dashed #c9c2b2;
		color: #8a8273;
		background: #fffdf8;
	}

	.card-body {
		padding: 1.25rem 1.5rem 1.5rem;
		text-align: center;
	}
	.card-title {
		margin: 0 0 0.35rem;
		font-size: 1.5rem;
	}
	.card-description {
		margin: 0;
		color: #5a5347;
	}

	/* Subtle hover: lift slightly and add a soft shadow. Same for keyboard focus. */
	.link-card:hover,
	.link-card:focus-visible {
		transform: translateY(-4px);
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.1);
	}
	.link-card:hover .card-title {
		text-decoration: underline;
	}
	@media (prefers-reduced-motion: reduce) {
		.link-card {
			transition: none;
		}
		.link-card:hover,
		.link-card:focus-visible {
			transform: none;
		}
	}

	/* ===== variant="door" =====
	   Undo the card look: just the image, then the title. */
	.link-card--door {
		background: none;
		border: none;
		border-radius: 0;
		overflow: visible; /* let the door swing past its own edges */
		align-items: center;
	}
	/* Hover/focus on the link itself no longer lifts or shadows; the door swings instead. */
	.link-card--door:hover,
	.link-card--door:focus-visible {
		transform: none;
		box-shadow: none;
	}
	/* Keyboard focus: a clear outline around the whole link. */
	.link-card--door:focus-visible {
		outline: 3px solid #13202e;
		outline-offset: 6px;
		border-radius: 4px;
	}

	/* The image at its natural proportions: no fixed box, no cropping. */
	.link-card--door .card-image {
		/* As big as its column allows (max-width: 100%), and no taller than
		   --door-max-h if the page sets it. width/height auto + the two max limits
		   keep the image's own proportions, so it never stretches. */
		width: auto;
		height: auto;
		max-width: 100%;
		max-height: var(--door-max-h, none);
		aspect-ratio: auto;

		/* The swing.
		   - perspective(900px): how far the "camera" is. It gives the turn real 3D depth.
		   - rotateY(0deg): resting, closed.
		   - transform-origin: the hinge. The hinges in Deb's drawings sit about 26% in
		     from the left edge of the image, so the door pivots there. */
		transform: perspective(900px) rotateY(0deg);
		transform-origin: 26% 50%;
		/* Closing: a springy curve that overshoots slightly, so the door settles back. */
		transition: transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.link-card--door:hover .card-image,
	.link-card--door:focus-visible .card-image {
		transform: perspective(900px) rotateY(-24deg);
		/* Opening: quick and smooth. */
		transition: transform 0.35s ease-out;
	}

	.link-card--door .card-body {
		padding: 0.75rem 0 0;
	}

	/* No swing for visitors who turn animation off; the title underline still shows hover. */
	@media (prefers-reduced-motion: reduce) {
		.link-card--door .card-image,
		.link-card--door:hover .card-image,
		.link-card--door:focus-visible .card-image {
			transform: none;
			transition: none;
		}
	}
</style>
