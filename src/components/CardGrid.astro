---
// CardGrid.astro
// A responsive grid of clickable cards: a square image (or a dashed placeholder
// labeled with the title), then the title below. Used by /art/series and
// /art/installations.
//
// Usage:
//   <CardGrid items={series} baseUrl="/art/series" />
//   → each card links to `${baseUrl}/${item.slug}`, e.g. /art/series/headstones
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Any list whose entries have at least these fields works here.
// Series and Installation entries both do.
export interface CardItem {
	slug: string;
	title: string;
	image?: ImageMetadata;
	imageAlt?: string;
}

interface Props {
	items: CardItem[];
	baseUrl: string; // e.g. "/art/series" (no trailing slash)
}

const { items, baseUrl } = Astro.props;
---

<ul class="card-grid">
	{
		items.map((item) => (
			<li>
				<a class="card" href={`${baseUrl}/${item.slug}`}>
					{item.image ? (
						<Image src={item.image} alt={item.imageAlt ?? ''} width={600} class="card-image" />
					) : (
						<div class="card-image card-placeholder" aria-hidden="true">
							[{item.title}]
						</div>
					)}
					<h2 class="card-title">{item.title}</h2>
				</a>
			</li>
		))
	}
</ul>

<style>
	/* Responsive grid: 3 columns on desktop, 2 on tablets, 1 on phones. */
	.card-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2.5rem 2rem;
		max-width: 1000px;
		margin: 0 auto;
		padding: 0;
		list-style: none;
	}
	@media (max-width: 900px) {
		.card-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 560px) {
		.card-grid {
			grid-template-columns: 1fr;
			max-width: 360px;
		}
	}

	/* Like the doors on Her Art: no card box, just the image and the title. */
	.card {
		display: block;
		color: inherit;
		text-decoration: none;
		text-align: center;
	}

	/* Square image area. Real images are shown whole (contain), never cropped. */
	.card-image {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1 / 1;
		object-fit: contain;
		transition:
			transform 0.2s ease,
			filter 0.2s ease;
	}
	.card-placeholder {
		display: grid;
		place-items: center;
		padding: 1rem;
		border: 2px dashed #c9c2b2;
		border-radius: 8px;
		color: #8a8273;
	}

	.card-title {
		margin: 0.75rem 0 0;
		font-size: 1.25rem;
	}

	/* Subtle hover: the image lifts a little with a soft shadow under it. */
	.card:hover .card-image,
	.card:focus-visible .card-image {
		transform: translateY(-4px);
		filter: drop-shadow(0 8px 10px rgba(0, 0, 0, 0.12));
	}
	.card:hover .card-title {
		text-decoration: underline;
	}
	.card:focus-visible {
		outline: 3px solid #13202e;
		outline-offset: 6px;
		border-radius: 4px;
	}
	@media (prefers-reduced-motion: reduce) {
		.card-image {
			transition: none;
		}
		.card:hover .card-image,
		.card:focus-visible .card-image {
			transform: none;
		}
	}
</style>
