---
// ArtBubble.astro
// A small floating "art bubble" in the bottom-right corner, like a chat widget.
//
// Usage (on any page):
//   import ArtBubble from '../components/ArtBubble.astro';
//   import signsImg from '../assets/images/her-art/booths/signs-800.jpg';
//   <ArtBubble bubbleImage={signsImg} cardImage={signsImg} text="Order this print" href="/shop/prints#print-sit-with-it-all" />
//
// Props (all required):
//   bubbleImage: image in the floating 64px circle (cropped to fill it), imported from src/assets/images/
//   cardImage:   image in the card that opens on click (shown whole); can be the same image
//   text:  a short line shown in the open card, also used as the button's label
//   href:  where the card's link goes
//
// Behavior:
//   - Appears 2 seconds after the page loads (fade + gentle pop).
//   - Starts closed: a 64px round bubble showing the image cropped to a circle.
//   - Click the bubble → a small card opens above it (bigger image, the text, a link).
//   - Click the bubble again, or press Escape → back to the bubble.
//   - It can't be dismissed completely; the bubble always stays.
//   - Hidden on screens narrower than 768px (phones).
//   - With "reduce motion" turned on in the visitor's settings, it appears without animating.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	/** Image in the floating circle in the corner. */
	bubbleImage: ImageMetadata;
	/** Image in the card that opens when the bubble is clicked. */
	cardImage: ImageMetadata;
	text: string;
	href: string;
}

const { bubbleImage, cardImage, text, href } = Astro.props;

// A unique id so the button can point at its own card (aria-controls),
// even if a page ever has more than one bubble.
const cardId = `art-bubble-card-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="art-bubble">
	<div class="art-bubble-card" id={cardId} hidden>
		<Image src={cardImage} alt="" widths={[240, 480]} sizes="240px" class="art-bubble-card-image" />
		<p class="art-bubble-text">{text}</p>
		<a class="art-bubble-link" href={href}>Take a look →</a>
	</div>

	<button
		type="button"
		class="art-bubble-toggle"
		aria-label={text}
		aria-expanded="false"
		aria-controls={cardId}
	>
		<Image src={bubbleImage} alt="" width={128} class="art-bubble-thumb" />
	</button>
</div>

<style>
	/* Pinned to the bottom-right corner of the window, above everything else.
	   Hidden until the script adds .is-visible (2 seconds after load).
	   visibility: hidden also keeps it out of the Tab order until then. */
	.art-bubble {
		position: fixed;
		right: 1.5rem;
		bottom: 1.5rem;
		z-index: 50;
		opacity: 0;
		visibility: hidden;
		transform: scale(0.6);
		transform-origin: bottom right;
		transition:
			opacity 0.35s ease,
			/* cubic-bezier with a value above 1 overshoots a little: the "pop". */
			transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
			visibility 0s linear 0.35s;
	}
	.art-bubble.is-visible {
		opacity: 1;
		visibility: visible;
		transform: scale(1);
		transition:
			opacity 0.35s ease,
			transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
			visibility 0s;
	}

	/* The closed bubble: a 64px circle with the image cropped to fill it. */
	.art-bubble-toggle {
		display: block;
		width: 64px;
		height: 64px;
		padding: 0;
		border: 3px solid var(--pink);
		border-radius: 50%;
		background: var(--pink);
		overflow: hidden;
		cursor: pointer;
		box-shadow: 0 6px 18px rgba(19, 32, 46, 0.25);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}
	.art-bubble-toggle:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 24px rgba(19, 32, 46, 0.3);
	}
	.art-bubble-toggle:focus-visible {
		outline: 3px solid var(--ink);
		outline-offset: 3px;
	}
	.art-bubble-thumb {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* The open card: sits just above the bubble, right edges lined up. */
	.art-bubble-card {
		position: absolute;
		right: 0;
		bottom: calc(100% + 12px);
		width: 240px;
		padding: 0.75rem;
		border-radius: 14px;
		background: #fff;
		border-top: 6px solid var(--pink);
		box-shadow: 0 10px 30px rgba(19, 32, 46, 0.22);
		text-align: center;
		color: var(--ink);
		animation: art-bubble-open 0.2s ease-out;
	}
	/* The hidden attribute normally means display: none; keep it that way even
	   though .art-bubble-card sets other display-related styles. */
	.art-bubble-card[hidden] {
		display: none;
	}
	@keyframes art-bubble-open {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	.art-bubble-card-image {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 8px;
	}
	.art-bubble-text {
		margin: 0.75rem 0 0.6rem;
		font-weight: 700;
		font-size: 1.05rem;
	}
	.art-bubble-link {
		display: inline-block;
		padding: 0.45rem 1rem;
		border-radius: 999px;
		background: var(--pink);
		color: var(--ink);
		font-weight: 600;
		text-decoration: none;
	}
	.art-bubble-link:hover {
		text-decoration: underline;
	}
	.art-bubble-link:focus-visible {
		outline: 3px solid var(--ink);
		outline-offset: 2px;
	}

	/* Phones: don't show it at all. */
	@media (max-width: 767.98px) {
		.art-bubble {
			display: none;
		}
	}

	/* Reduce motion: appear and open instantly, no pop, lift, or slide. */
	@media (prefers-reduced-motion: reduce) {
		.art-bubble,
		.art-bubble.is-visible {
			transform: none;
			transition: none;
		}
		.art-bubble-toggle {
			transition: none;
		}
		.art-bubble-toggle:hover {
			transform: none;
		}
		.art-bubble-card {
			animation: none;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('.art-bubble').forEach((bubble) => {
		const toggle = bubble.querySelector<HTMLButtonElement>('.art-bubble-toggle')!;
		const card = bubble.querySelector<HTMLElement>('.art-bubble-card')!;

		const setOpen = (open: boolean) => {
			card.hidden = !open;
			toggle.setAttribute('aria-expanded', String(open));
		};

		// Show the bubble 2 seconds after the page has loaded.
		const show = () => setTimeout(() => bubble.classList.add('is-visible'), 2000);
		if (document.readyState === 'complete') show();
		else window.addEventListener('load', show, { once: true });

		// Click the bubble: open if closed, close if open.
		toggle.addEventListener('click', () => setOpen(card.hidden));

		// Escape closes the card and puts keyboard focus back on the bubble.
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !card.hidden) {
				setOpen(false);
				toggle.focus();
			}
		});
	});
</script>
