---
// art.astro → the Her Art page, served at "/art"
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkCard from '../components/LinkCard.astro';
import seriesDoor from '../assets/images/her-art/series-door.png';
import installationsDoor from '../assets/images/her-art/installations-door.png';
---

<BaseLayout title="Her Art"> 

	<div class="art-cards">
		<LinkCard
			href="/art/series" 
			image={seriesDoor}
			variant="door"
		/>
		<LinkCard
			href="/art/installations" 
			image={installationsDoor}
			variant="door"
		/>
	</div>
</BaseLayout>

<style>
	.page-title {
		text-align: center;
		margin: 1rem 0 2rem;
	}

	/* Two equal columns side by side on desktop. */
	.art-cards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
		max-width: 1000px;
		margin: 0 auto 3rem;
	}

	/* Phones: one column, cards stacked. */
	@media (max-width: 700px) {
		.art-cards {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}
</style>
