---
// about.astro → the About Deb page, served at "/about"
import BaseLayout from '../layouts/BaseLayout.astro';
import IconDivider from '../components/IconDivider.astro';
import feet from '../assets/images/icons/feet1.png';
import { Image } from 'astro:assets';
import blessings from '../assets/images/about/mailchimp-blessings.png';
import houseTulips from '../assets/images/about/house/house-tulips.jpg';
import debPhoto from '../assets/images/about/aunt_deb_img.png';
import StoryMap from '../components/StoryMap.astro';
---

<BaseLayout title="About Deb">
	<article class="about"> 

		<!-- Deb's clickable Map of the Territory -->
		<StoryMap />

		  
		<!-- 3 + 6: story text and Deb's blessings note, side by side on desktop -->
		<div class="story">
		<!-- 3. -->
		 

		<!-- 6. Second photo -->
		<Image
			src={blessings}
			alt="Deb's handwritten note: “Thank you ALL for supporting me, my art, my life. May this site inspire you, comfort you, lift your spirits and open your heart. Many blessings, Deb.” Below it, Deb sits in a pink armchair in front of a painted fireplace with a black-and-white cat. debkoffman.com"
			widths={[480, 720, 960]}
			sizes="(max-width: 520px) 100vw, 480px"
			class="blessings"
		/>
		</div>

		 

		<!-- 11. Link to Deb's House: the whole card is one link -->
		<a class="house-link" href="/about/house">
			<Image
				src={houseTulips}
				alt="Deb's white house with a red roof and front porch, with her hand-drawn pink tulips along the front"
				width={600}
				class="house-photo"
			/>
			<span class="house-link-text">Come see Deb's house →</span>
		</a>
	</article>
</BaseLayout>

<style>
	.about {
		padding-bottom: 3rem;
	}
	.page-title {
		text-align: center;
		margin: 1rem 0 2rem;
	}

	/* Narrow, centered text column: about 65 characters per line. */
	.prose,
	.intro-text {
		max-width: 65ch;
	}
	.prose {
		margin: 0 auto;
	}
	.prose h2 {
		margin-top: 0;
	}
	.prose p,
	.intro-text p {
		font-size: 1.125rem;
		line-height: 1.7;
	}

	/* 1. Intro: two columns on desktop. */
	.intro {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
		gap: 2.5rem;
		align-items: center;
		max-width: 960px;
		margin: 0 auto;
	}
	.intro-photo {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 8px;
	}

	/* 5. Pull quote: bigger, centered, framed by thin rules so it stands out. */
	.pull-quote {
		max-width: 40ch;
		margin: 3rem auto;
		padding: 1.5rem 0;
		border-top: 2px solid #c9c2b2;
		border-bottom: 2px solid #c9c2b2;
		text-align: center;
	}
	.pull-quote p {
		margin: 0;
		font-size: clamp(1.5rem, 4vw, 2.25rem); /* scales between phone and desktop */
		line-height: 1.3;
		font-style: italic;
	}

	/* 3 + 6: text column on the left, image column on the right. */
	.story {
		display: grid;
		grid-template-columns: minmax(0, 65ch) minmax(0, 420px);
		justify-content: center; /* center the pair on wide screens */
		align-items: start; /* both columns start at the top */
		gap: 3rem;
		margin: 0 auto 3rem;
	}
	.story .prose {
		margin: 0; /* the grid places it, so no auto-centering */
	}

	/* 6. Deb's blessings note: tall image shown at its own proportions (no cropping). */
	.blessings {
		display: block;
		width: 100%;
		height: auto;
	}

	/* 11. Deb's House card */
	.house-link {
		display: block;
		max-width: 600px;
		margin: 0 auto;
		color: inherit;
		text-decoration: none;
		text-align: center;
		border-radius: 10px;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}
	/* The house photo at its natural proportions, full width of the card, rounded corners. */
	.house-photo {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 10px;
		margin-bottom: 0.75rem;
	}
	.house-link-text {
		display: inline-block;
		font-size: 1.25rem;
		font-weight: 600;
		padding-bottom: 0.75rem;
	}
	/* Subtle hover: lift slightly and add a soft shadow. */
	.house-link:hover,
	.house-link:focus-visible {
		transform: translateY(-3px);
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
	}
	.house-link:hover .house-link-text {
		text-decoration: underline;
	}
	@media (prefers-reduced-motion: reduce) {
		.house-link {
			transition: none;
		}
		.house-link:hover,
		.house-link:focus-visible {
			transform: none;
		}
	}

	/* Narrower screens: stack the story text and the blessings note. */
	@media (max-width: 900px) {
		.story {
			grid-template-columns: minmax(0, 65ch);
		}
		.blessings {
			max-width: 480px;
			margin: 0 auto;
		}
	}

	/* Phones: stack the intro (photo on top, text below). */
	@media (max-width: 700px) {
		.intro {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}
</style>
