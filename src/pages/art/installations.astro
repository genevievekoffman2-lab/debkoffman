---
// art/installations.astro → the Installations & Booths page, served at "/art/installations"
// Shows one card per entry in src/data/installations.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardGrid from '../../components/CardGrid.astro';
import { installations } from '../../data/installations';
import { frames } from '../../data/frames';
---

<BaseLayout title="Installations & Booths">
	<h1 class="page-title">Installations &amp; Booths</h1>

	<CardGrid items={installations} baseUrl="/art/installations" frames={frames} />

	<p class="back">
		<a class="back-link" href="/art">← Back to Her Art</a>
	</p>
</BaseLayout>

<style>
	.page-title {
		text-align: center;
		margin: 1rem 0 2rem;
	}
	.back {
		text-align: center;
		margin: 3rem 0;
	}
	.back-link {
		color: inherit;
		font-weight: 600;
	}
</style>
