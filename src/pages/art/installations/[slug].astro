---
// art/installations/[slug].astro → one page per installation, e.g. "/art/installations/complaint-booth"
//
// getStaticPaths() builds one page for each entry in installations.ts.
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { installations, type Installation } from '../../../data/installations';

export const getStaticPaths = (() => {
	return installations.map((item) => ({
		params: { slug: item.slug }, // fills in [slug] in the URL
		props: { installation: item }, // the data this page receives
	}));
}) satisfies GetStaticPaths;

interface Props {
	installation: Installation;
}

const { installation: item } = Astro.props;
---

<BaseLayout title={item.title}>
	<article class="installation-page">
		<h1>{item.title}</h1>
		<p class="description">{item.description}</p>

		{
			item.photos && item.photos.length > 0 ? (
				<ul class="gallery">
					{item.photos.map((photo) => (
						<li>
							<figure>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[400, 800]}
									sizes="(max-width: 600px) 100vw, 480px"
								/>
								{photo.caption && <figcaption>{photo.caption}</figcaption>}
							</figure>
						</li>
					))}
				</ul>
			) : (
				<div class="placeholder media">[Photos go here]</div>
			)
		}
		<div class="placeholder media video">[Video goes here]</div>

		<a class="back-link" href="/art/installations">← Back to Installations &amp; Booths</a>
	</article>
</BaseLayout>

<style>
	.installation-page {
		max-width: 1000px;
		margin: 0 auto 3rem;
		text-align: center;
	}
	h1 {
		margin: 1rem 0 0.5rem;
	}
	.description {
		max-width: 65ch;
		margin: 0 auto 2rem;
		font-size: 1.125rem;
	}
	.media {
		min-height: 300px;
		display: grid;
		place-items: center;
		color: #8a8273;
	}
	/* Photo gallery: 2 columns on desktop, 1 on phones. Each photo keeps its own
	   shape (tall or square) and sits centered in its cell. */
	.gallery {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
		align-items: center;
		margin: 0 0 2.5rem;
		padding: 0;
		list-style: none;
	}
	.gallery figure {
		margin: 0;
	}
	.gallery img {
		display: block;
		width: 100%;
		max-width: 480px;
		height: auto;
		margin: 0 auto;
	}
	.gallery figcaption {
		margin-top: 0.5rem;
		color: #5a5347;
	}
	@media (max-width: 600px) {
		.gallery {
			grid-template-columns: 1fr;
		}
	}

	/* Video area: widescreen 16:9 shape, the usual shape for video. */
	.video {
		min-height: 0;
		aspect-ratio: 16 / 9;
		max-width: 800px;
		margin-left: auto;
		margin-right: auto;
	}
	.back-link {
		color: inherit;
		font-weight: 600;
	}
</style>
