---
// shop.astro → the Shop landing page, served at "/shop"
// One card per collection in src/data/shopCategories.ts (same order as that list).
// Each card links to /shop/<slug>.
import BaseLayout from '../layouts/BaseLayout.astro';
import CardGrid from '../components/CardGrid.astro';
import { shopCategories } from '../data/shopCategories';
---

<BaseLayout title="Shop">
	<h1 class="page-title">Shop</h1>

	<div class="shop-cards">
		<CardGrid items={shopCategories} baseUrl="/shop" />
	</div>
</BaseLayout>

<style>
	.page-title {
		text-align: center;
		margin: 1rem 0 2rem;
	}
	/* Space below the grid before the footer. */
	.shop-cards {
		margin-bottom: 3rem;
	}
</style>
