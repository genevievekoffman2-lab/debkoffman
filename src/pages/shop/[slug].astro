---
// shop/[slug].astro → one page per shop category, e.g. "/shop/books"
//
// getStaticPaths() builds one page for each entry in shopCategories.ts.
// Products are placeholders for now. A real cart (Shopify or Stripe) comes later.
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShopNav from '../../components/ShopNav.astro';
import { shopCategories, type ShopCategory } from '../../data/shopCategories';

export const getStaticPaths = (() => {
	return shopCategories.map((c) => ({
		params: { slug: c.slug }, // fills in [slug] in the URL
		props: { category: c }, // the data this page receives
	}));
}) satisfies GetStaticPaths;

interface Props {
	category: ShopCategory;
}

const { category } = Astro.props;

// Six placeholder products until real ones are connected.
const placeholderProducts = Array.from({ length: 6 });
---

<BaseLayout title={category.title}>
	<ShopNav slot="subnav" current={category.slug} />

	<header class="category-header">
		<h1>{category.title}</h1>
		<p>{category.description}</p>
	</header>

	<ul class="product-grid">
		{
			placeholderProducts.map(() => (
				<li class="product">
					<div class="product-image" aria-hidden="true">
						[Image]
					</div>
					<h2 class="product-name">[Product name]</h2>
					<p class="product-price">[Price]</p>
					<button type="button" class="add-to-cart" disabled>
						Add to cart
					</button>
				</li>
			))
		}
	</ul>
</BaseLayout>

<style>
	.category-header {
		text-align: center;
		max-width: 65ch;
		margin: 1rem auto 2.5rem;
	}
	.category-header h1 {
		margin: 0 0 0.5rem;
	}
	.category-header p {
		font-size: 1.125rem;
		color: #5a5347;
	}

	/* 3 columns on desktop, 2 on tablets, 1 on phones (same breakpoints as CardGrid). */
	.product-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2.5rem 2rem;
		max-width: 1000px;
		margin: 0 auto 3rem;
		padding: 0;
		list-style: none;
	}
	@media (max-width: 900px) {
		.product-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 560px) {
		.product-grid {
			grid-template-columns: 1fr;
			max-width: 360px;
		}
	}

	.product {
		text-align: center;
	}
	.product-image {
		display: grid;
		place-items: center;
		aspect-ratio: 1 / 1;
		border: 2px dashed #c9c2b2;
		border-radius: 8px;
		color: #8a8273;
	}
	.product-name {
		margin: 0.75rem 0 0.25rem;
		font-size: 1.15rem;
	}
	.product-price {
		margin: 0 0 0.75rem;
		color: #5a5347;
	}

	/* Disabled until a real cart is connected. */
	.add-to-cart {
		font: inherit;
		font-weight: 600;
		padding: 0.5rem 1.25rem;
		border: 2px solid #13202e;
		border-radius: 999px;
		background: #13202e;
		color: #fffdf8;
		cursor: pointer;
	}
	.add-to-cart:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}
</style>
