---
// shop/[slug].astro → one page per shop category, e.g. "/shop/books"
//
// getStaticPaths() builds one page for each entry in shopCategories.ts.
// Each page shows the products from products.ts whose categorySlug matches.
// Clicking a product opens ProductDialog (one shared overlay).
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductDialog from '../../components/ProductDialog.astro';
import SoulSupportDraw from '../../components/SoulSupportDraw.astro';
import { shopCategories, type ShopCategory } from '../../data/shopCategories';
import { products, formatPrice } from '../../data/products';

export const getStaticPaths = (() => {
	return shopCategories.map((c) => ({
		params: { slug: c.slug }, // fills in [slug] in the URL
		props: { category: c }, // the data this page receives
	}));
}) satisfies GetStaticPaths;

interface Props {
	category: ShopCategory;
}

const { category } = Astro.props;
const categoryProducts = products.filter((p) => p.categorySlug === category.slug);

// Book covers keep their own shape (usually taller than wide) instead of a square box.
const naturalShape = category.slug === 'books';

// Soul Support: two columns, "draw a card" on the left, products on the right.
const isSoulSupport = category.slug === 'soul-support';
---

<BaseLayout title={category.title}>
	{/* "Back to Shop" on every category except Soul Support, which opens with the bowl. */}
	{!isSoulSupport && (
		<p class="back">
			<a class="back-link" href="/shop">← Back to Shop</a>
		</p>
	)}

	{/* Skipped on Soul Support so the bowl starts near the top. */}
	{!isSoulSupport && <header class="category-header" />}

	{/* On Soul Support this becomes a two-column grid (.two-col): the draw on the
	    left, the products on the right. On other pages it's a plain wrapper. */}
	<div class:list={['category-body', { 'two-col': isSoulSupport }]}>
	{isSoulSupport && (
		<div class="draw-col">
			<SoulSupportDraw />
		</div>
	)}

	{
		categoryProducts.length === 0 ? (
			<p class="empty">Nothing here yet. Check back soon.</p>
		) : (
			<ul class:list={['product-grid', { 'natural-shape': naturalShape }]}>
				{categoryProducts.map((p) => (
					// id lets other pages link straight to this product, e.g. /shop/prints#print-sit-with-it-all
					<li id={p.id}>
						{/* The whole card is a button that opens the overlay. aria-haspopup tells
						    screen readers it opens a dialog. */}
						<button type="button" class="product-card" data-product-id={p.id} aria-haspopup="dialog">
							{p.image ? (
								<Image src={p.image} alt={p.imageAlt ?? ''} width={600} class="product-image" />
							) : (
								<span class="product-image product-placeholder" aria-hidden="true">
									[Image]
								</span>
							)}
							<span class="product-name">{p.name}</span>
							<span class="product-price">{formatPrice(p.price)}</span>
						</button>
					</li>
				))}
			</ul>
		)
	}
	</div>

	<ProductDialog products={categoryProducts} naturalShape={naturalShape} />
</BaseLayout>

<style>
	/* Same look as the back links on the Series and Installations pages. */
	.back {
		text-align: center;
		margin: 1rem 0;
	}
	.back-link {
		color: inherit;
		font-weight: 600;
	}
	.category-header {
		text-align: center;
		max-width: 65ch;
		margin: 1rem auto 2.5rem;
	}
	.category-header h1 {
		margin: 0 0 0.5rem;
	}
	.category-header p {
		font-size: 1.125rem;
		color: #5a5347;
	}
	.empty {
		text-align: center;
		color: #5a5347;
	}

	/* 3 columns on desktop, 2 on tablets, 1 on phones (same breakpoints as CardGrid). */
	.product-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2.5rem 2rem;
		max-width: 1000px;
		margin: 0 auto 3rem;
		padding: 0;
		list-style: none;
	}
	@media (max-width: 900px) {
		.product-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 560px) {
		.product-grid {
			grid-template-columns: 1fr;
			max-width: 360px;
		}
	}

	/* ---------- SOUL SUPPORT: two columns ----------
	   Left (45%): the card draw, sticky, so the bowl stays in view while the
	   products scroll past. Right (55%): the products, stacked.
	   align-items: start is needed for sticky to work: otherwise the left
	   column stretches to the full height of the row and has nowhere to stick.
	   (The header isn't sticky, it scrolls away, so "top" is just a small gap
	   from the top of the screen.) */
	@media (min-width: 901px) {
		.two-col {
			display: grid;
			grid-template-columns: 45fr 55fr;
			align-items: start;
			gap: 3rem;
		}
		.draw-col {
			position: sticky;
			top: 1.5rem;
		}
		.two-col .product-grid {
			margin: 0 auto 3rem;
		}
	}
	/* Soul Support products: stacked, one above the other, at every width.
	   Sized so both fit on the screen right when the page loads, header
	   included. Everything that isn't a photo adds up to about 23rem: the
	   header (~165px) + page padding + 2 x name/price (~4rem each) + the
	   1.5rem gap between them. Each photo is as wide as it is tall, so its
	   size = (screen height - 23rem) / 2. vh = 1% of the screen height.
	   Only the photo shrinks; the name and price keep the full column width
	   so they stay on one line. Never bigger than 420px. */
	.two-col .product-grid {
		grid-template-columns: minmax(0, 1fr);
		row-gap: 1.5rem;
		max-width: 420px;
	}
	.two-col .product-image {
		width: min(100%, calc((100vh - 23rem) / 2));
		margin: 0 auto;
	}
	/* Under 900px: stacked, draw first, products below. */
	@media (max-width: 900px) {
		.draw-col {
			margin-bottom: 3rem;
		}
	}

	/* Card = a button with no button look: image, name, price. */
	/* When a link jumps to a product (#print-sit-with-it-all), leave a little space above it. */
	.product-grid li {
		scroll-margin-top: 2rem;
	}
	.product-card {
		display: block;
		width: 100%;
		padding: 0;
		border: none;
		background: none;
		font: inherit;
		color: inherit;
		text-align: center;
		cursor: pointer;
	}
	.product-image {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1 / 1;
		object-fit: contain;
		transition:
			transform 0.2s ease,
			filter 0.2s ease;
	}
	/* Books: no square box, so each cover shows at its own proportions.
	   align-items: end lines up the bottoms of the covers in each row, so the
	   titles and prices under them stay level even when cover heights differ. */
	.natural-shape {
		align-items: end;
	}
	.natural-shape .product-image {
		aspect-ratio: auto;
	}
	.product-placeholder {
		display: grid;
		place-items: center;
		border: 2px dashed #c9c2b2;
		border-radius: 8px;
		color: #8a8273;
	}
	.product-name {
		display: block;
		margin: 0.75rem 0 0.25rem;
		font-size: 1.15rem;
		font-weight: 700;
	}
	.product-price {
		display: block;
		color: #5a5347;
	}

	/* Same subtle hover lift as the Series/Installations cards. */
	.product-card:hover .product-image,
	.product-card:focus-visible .product-image {
		transform: translateY(-4px);
		filter: drop-shadow(0 8px 10px rgba(0, 0, 0, 0.12));
	}
	.product-card:hover .product-name {
		text-decoration: underline;
	}
	.product-card:focus-visible {
		outline: 3px solid #13202e;
		outline-offset: 6px;
		border-radius: 4px;
	}
	@media (prefers-reduced-motion: reduce) {
		.product-image {
			transition: none;
		}
		.product-card:hover .product-image,
		.product-card:focus-visible .product-image {
			transform: none;
		}
	}
</style>
